// the window and file icon (LoadIconW(inst, MAKEINTRESOURCEW(1))), drawn by tools/installer/art.py
1 ICON "unchained.ico"

// the version, from src/common/version.h through CMakeLists.txt
1 VERSIONINFO
FILEVERSION UNCHAINED_VERSION_NUMBERS
PRODUCTVERSION UNCHAINED_VERSION_NUMBERS
FILEOS 0x40004
FILETYPE 0x1
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Unchained"
            VALUE "ProductName", "Unchained"
            VALUE "FileVersion", UNCHAINED_VERSION
            VALUE "ProductVersion", UNCHAINED_VERSION
            VALUE "OriginalFilename", "Unchained.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
