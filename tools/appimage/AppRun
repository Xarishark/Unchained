#!/bin/sh
# the AppImage's entry: the bundled libraries first, then Unchained with the arguments it was given
here=$(dirname "$(readlink -f "$0")")
export LD_LIBRARY_PATH="$here/usr/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"

# the applications menu, as the Windows installer's Start menu shortcuts: Unchained and Unchained Configuration,
# pointing at this file wherever it is now (rewritten when it moved). A file named unchained.desktop.off beside the
# entry keeps it off.
if [ -n "$APPIMAGE" ]; then
    apps=${XDG_DATA_HOME:-$HOME/.local/share}/applications
    icons=${XDG_DATA_HOME:-$HOME/.local/share}/icons/hicolor/256x256/apps
    entry=$apps/unchained.desktop
    if [ ! -e "$entry.off" ] && ! grep -qF "Exec=\"$APPIMAGE\"" "$entry" 2>/dev/null; then
        mkdir -p "$apps" "$icons" && cp "$here/unchained.png" "$icons/unchained.png" 2>/dev/null
        cat > "$entry.tmp" <<EOF
[Desktop Entry]
Type=Application
Name=Unchained
Comment=Whiplash (original Xbox) on Linux, from your own disc
Exec="$APPIMAGE"
Icon=unchained
Categories=Game;
Terminal=false
Actions=Configuration;

[Desktop Action Configuration]
Name=Unchained Configuration
Exec="$APPIMAGE" --configure
EOF
        mv "$entry.tmp" "$entry" 2>/dev/null
    fi
fi

exec "$here/usr/bin/Unchained" "$@"
